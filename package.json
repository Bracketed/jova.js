{
	"name": "@bracketed/jova.js",
	"description": "Jova.js - An advanced Express.js framework by Bracketed Softworks!",
	"packageManager": "yarn@4.9.0",
	"version": "2.0.14",
	"publishConfig": {
		"access": "public"
	},
	"license": "Apache-2.0",
	"author": "@bracketed",
	"main": "lib/cjs/index.cjs",
	"module": "lib/esm/index.mjs",
	"types": "lib/cjs/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./lib/esm/index.d.mts",
				"default": "./lib/esm/index.mjs"
			},
			"require": {
				"types": "./lib/cjs/index.d.ts",
				"default": "./lib/cjs/index.cjs"
			}
		},
		"./types": {
			"import": {
				"types": "./lib/esm/types/index.d.mts",
				"default": "./lib/esm/types/index.mjs"
			},
			"require": {
				"types": "./lib/cjs/types/index.d.ts",
				"default": "./lib/cjs/types/index.cjs"
			}
		},
		"./decorators": {
			"import": {
				"types": "./lib/esm/decorators/index.d.mts",
				"default": "./lib/esm/decorators/index.mjs"
			},
			"require": {
				"types": "./lib/cjs/decorators/index.d.ts",
				"default": "./lib/cjs/decorators/index.cjs"
			}
		}
	},
	"files": [
		"lib"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Bracketed/jova.js"
	},
	"homepage": "https://jova.js.org/",
	"sideEffects": false,
	"bugs": {
		"url": "https://github.com/bracketed/jova.js/issues"
	},
	"keywords": [
		"bracketed",
		"jova.js",
		"typescript",
		"express",
		"framework",
		"http",
		"server",
		"webserver",
		"web",
		"rest",
		"router",
		"app",
		"api",
		"redis",
		"cors"
	],
	"scripts": {
		"build": "tsup",
		"update": "yarn upgrade-interactive",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@bracketed/prettier-configuration": "^1.0.0",
		"@bracketed/tsup-configuration": "^1.0.5",
		"@bracketed/typescript-config": "^4.7.1",
		"@swc/core": "^1.13.1",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.3",
		"@types/node": "^24.1.0",
		"prettier": "^3.6.2",
		"tsup": "^8.5.0",
		"typescript": "^5.8.3"
	},
	"dependencies": {
		"@bracketed/logger": "^1.1.1",
		"@sapphire/stopwatch": "^1.5.4",
		"cors": "^2.8.5",
		"esbuild": "^0.25.8",
		"express": "^5.1.0",
		"express-rate-limit": "^8.0.1",
		"express-serve-static-core": "^0.1.1",
		"is2": "^2.0.9",
		"serve-static": "^2.2.0",
		"yaml": "^2.8.0"
	},
	"engines": {
		"node": ">=18"
	},
	"prettier": "@bracketed/prettier-configuration"
}
