{
	"name": "@bracketed/jova.js",
	"description": "Jova.js - A semi-advanced Express.js framework by Bracketed Softworks!",
	"packageManager": "yarn@4.6.0",
	"version": "1.6.2",
	"publishConfig": {
		"access": "public"
	},
	"license": "Apache-2.0",
	"author": "@bracketed",
	"main": "lib/cjs/index.cjs",
	"module": "lib/esm/index.mjs",
	"types": "lib/cjs/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./lib/esm/index.d.mts",
				"default": "./lib/esm/index.mjs"
			},
			"require": {
				"types": "./lib/cjs/index.d.cts",
				"default": "./lib/cjs/index.cjs"
			}
		},
		"./types": {
			"import": {
				"types": "./lib/esm/types/index.d.mts",
				"default": "./lib/esm/types/index.mjs"
			},
			"require": {
				"types": "./lib/cjs/types/index.d.cts",
				"default": "./lib/cjs/types/index.cjs"
			}
		},
		"./decorators": {
			"import": {
				"types": "./lib/esm/decorators/index.d.mts",
				"default": "./lib/esm/decorators/index.mjs"
			},
			"require": {
				"types": "./lib/cjs/decorators/index.d.cts",
				"default": "./lib/cjs/decorators/index.cjs"
			}
		}
	},
	"files": [
		"lib"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Bracketed/jova.js"
	},
	"homepage": "https://jova.js.org/",
	"sideEffects": false,
	"bugs": {
		"url": "https://github.com/bracketed/jova.js/issues"
	},
	"keywords": [
		"bracketed",
		"typescript",
		"express",
		"framework",
		"http",
		"server",
		"webserver",
		"web",
		"rest",
		"router",
		"app",
		"api"
	],
	"scripts": {
		"build": "tsup",
		"update": "yarn upgrade-interactive",
		"docs": "typedoc-json-parser"
	},
	"devDependencies": {
		"@bracketed/typescript-config": "^4.4.0",
		"@types/express": "4.17.21",
		"@types/node": "^22.13.5",
		"@types/qs": "^6",
		"esbuild-plugin-file-path-extensions": "^2.1.4",
		"esbuild-plugin-version-injector": "^1.2.1",
		"jsdoc": "^4.0.4",
		"prettier": "^3.5.2",
		"tsup": "^8.4.0",
		"typedoc": "^0.27.9",
		"typescript": "^5.7.3",
		"yarn-check": "^0.0.3"
	},
	"dependencies": {
		"@bracketed/express": "^4.21.7",
		"@bracketed/logger": "^1.0.12",
		"express": "4.21.2",
		"ioredis": "^5.5.0",
		"is2": "^2.0.9",
		"qs": "^6.14.0",
		"reflect-metadata": "^0.2.2",
		"typedoc-json-parser": "^10.2.0"
	},
	"engines": {
		"node": ">= 16"
	}
}
